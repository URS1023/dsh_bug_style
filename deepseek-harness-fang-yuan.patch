+      `brand symbols: ${String(['wordmark', 'hero', 'agent', 'access'].every(key => Boolean(result.brands[key]?.symbol)))}`,
+      `functional labels preserved: ${String(result.functionalLabelsPreserved)}`,
+      '',
+    ].join('\n')
+
+    await compareOrRefreshGolden(EXPECTED, snapshot, MODE)
+    expect(tripwire.pageErrors).toEqual([])
+    expect(tripwire.warnings).toEqual([])
+  })
+
+  it.skipIf(MODE === 'record')('keeps the theme snapshot inventory closed', async () => {
+    await assertFixtureInventory(SNAPSHOT_DIR, ['ui.expected.md'])
+  })
+})
