@@ -0,0 +1,35 @@
+/** Theme-controlled decorative branding for stable product UI seats. */
+import clsx from 'clsx'
+import css from './ThemeBrand.module.css'
+
+/** The visual seat whose theme-owned text and mark are rendered. */
+export type ThemeBrandVariant = 'wordmark' | 'rail' | 'hero' | 'agent' | 'access' | 'workspace'
+
+/** Props for {@link ThemeBrand}. */
+export interface ThemeBrandProps {
+  /** Selects the semantic content token and geometry for this seat. */
+  variant: ThemeBrandVariant
+  /** Optional consumer positioning class; colors and copy remain theme-owned. */
+  className?: string | undefined
+}
+
+/**
+ * Render one decorative brand seat from ui-theme CSS variables. The root is
+ * hidden by default and always excluded from the accessibility tree; owning
+ * controls retain their real labels and behavior.
+ * @param props - semantic seat and optional positioning class.
+ * @returns the theme-controlled mark, label, and optional hero badge.
+ */
+export function ThemeBrand({ variant, className }: ThemeBrandProps) {
+  return (
+    <span
+      className={clsx(css.root, css[variant], className)}
+      data-theme-brand={variant}
+      aria-hidden="true"
+    >
+      {variant !== 'workspace' && <span className={css.mark} data-theme-brand-mark />}
+      {variant !== 'agent' && variant !== 'rail' && <span className={css.label} data-theme-brand-label />}
+      {variant === 'hero' && <span className={css.badge} data-theme-brand-badge />}
+    </span>
+  )
+}
