+/**
+ * Keyless browser proof for the opt-in Fang Yuan theme: the real product
+ * overlay enables its Host row, the client module activates a concrete dark
+ * palette, the embedded WebP paints the application frame, and the decorative
+ * seal lands without browser errors.
+ */
+import { fileURLToPath } from 'node:url'
+import type { Browser, Page } from 'playwright'
+import { chromium } from 'playwright'
+import { afterAll, beforeAll, describe, expect, it, onTestFailed } from 'vitest'
+import {
+  assertFixtureInventory, compareOrRefreshGolden, launchWebScaffold, watchConsole, webSnapshotMode,
+  type WebScaffold,
+} from './scaffold.ts'
+import { connectFreshWorkspace, newEnglishPage, saveFailureShot } from './support.ts'
+
+const OVERLAY = fileURLToPath(new URL('../../../examples/web-fang-yuan/cordis.yml', import.meta.url))
+const SNAPSHOT_DIR = fileURLToPath(new URL('./snapshots/fang-yuan-theme', import.meta.url))
+const EXPECTED = fileURLToPath(new URL('./snapshots/fang-yuan-theme/ui.expected.md', import.meta.url))
+const MODE = webSnapshotMode()
+
+describe('web e2e: opt-in Fang Yuan theme', () => {
+  let scaffold: WebScaffold
+  let browser: Browser
+  let page: Page
+  let tripwire: ReturnType<typeof watchConsole>
+
+  beforeAll(async () => {
+    scaffold = await launchWebScaffold({ extraOverlayPath: OVERLAY })
+    browser = await chromium.launch()
+    page = await newEnglishPage(browser)
+    tripwire = watchConsole(page)
+    await page.goto(scaffold.baseUrl, { waitUntil: 'load' })
+    await connectFreshWorkspace(page, scaffold.workspaceCwd)
+    await page.waitForSelector('[data-theme-brand="access"]', { timeout: 30_000 })
+  }, 120_000)
+
+  afterAll(async () => {
+    await browser?.close()
+    await scaffold?.close()
+  })
+
+  it.skipIf(MODE === 'record')('paints the character background and theme signature through the real plugin graph', async () => {
+    onTestFailed(() => saveFailureShot(page, 'web-e2e-fang-yuan-theme'))
+    const result = await page.evaluate(() => {
+      const frame = document.querySelector('[class*="frame"]')
+      const sigil = document.querySelector('[data-fang-yuan-sigil]')
+      if (!(frame instanceof HTMLElement) || !(sigil instanceof HTMLElement)) {
+        throw new Error('Fang Yuan frame or sigil missing')
+      }
+      const frameStyle = getComputedStyle(frame)
+      const bodyStyle = getComputedStyle(document.body)
+      const boot = (window as unknown as { __DSH_BOOT__?: { entries: { id: string }[] } }).__DSH_BOOT__
+      const brand = (variant: string): { display: string; label: string; badge: string; symbol: boolean } => {
+        const root = document.querySelector(`[data-theme-brand="${variant}"]`)
+        const label = root?.querySelector('[data-theme-brand-label]')
+        const badge = root?.querySelector('[data-theme-brand-badge]')
+        const mark = root?.querySelector('[data-theme-brand-mark]')
+        const content = (element: Element | null | undefined): string => {
+          if (element === null || element === undefined) return ''
+          return getComputedStyle(element, '::before').content.replace(/^["']|["']$/g, '')
+        }
+        return {
+          display: root === null ? 'missing' : getComputedStyle(root).display,
+          label: content(label),
+          badge: content(badge),
+          symbol: mark !== null && mark !== undefined
+            && getComputedStyle(mark).maskImage.includes('data:image/svg+xml'),
+        }
+      }
+      const brands = Object.fromEntries(
+        ['wordmark', 'hero', 'agent', 'access', 'workspace'].map(variant => [variant, brand(variant)]),
+      ) as Record<string, { display: string; label: string; badge: string; symbol: boolean }>
+      const functionalLabels = [...document.querySelectorAll<HTMLElement>('[data-theme-brand]')]
+        .map(element => element.closest('button')?.getAttribute('aria-label') ?? element.parentElement?.getAttribute('aria-label'))
+        .filter((value): value is string => value !== null)
+      const agentMode = document.querySelector('[data-agent-preset-label]')?.textContent?.trim() ?? ''
+      return {
+        moduleLoaded: boot?.entries.some(entry => entry.id === '@deepseek-ai/dsh-client-ui-fang-yuan-theme') === true,
+        darkScheme: document.body.hasAttribute('data-ds-dark-theme'),
+        embeddedWebp: frameStyle.backgroundImage.includes('data:image/webp;base64,'),
+        backgroundPosition: frameStyle.backgroundPosition,
+        baseSurface: bodyStyle.getPropertyValue('--dsw-alias-bg-base').trim(),
+        brandAccent: bodyStyle.getPropertyValue('--dsw-alias-brand-primary').trim(),
+        sigil: sigil.textContent,
+        sigilHidden: sigil.getAttribute('aria-hidden'),
+        brands,
+        functionalLabelsPreserved: functionalLabels.length >= 5 && functionalLabels.every(label => label.length > 0),
+        agentMode,
+      }
+    })
+    const snapshot = [
+      `module loaded: ${String(result.moduleLoaded)}`,
+      `dark scheme: ${String(result.darkScheme)}`,
+      `embedded WebP: ${String(result.embeddedWebp)}`,
+      `background position: ${result.backgroundPosition}`,
+      `base surface: ${result.baseSurface}`,
+      `brand accent: ${result.brandAccent}`,
+      `sigil: ${result.sigil}`,
+      `sigil aria-hidden: ${result.sigilHidden}`,
+      `brand wordmark: ${result.brands.wordmark?.label}`,
+      `brand hero: ${result.brands.hero?.label}`,
+      `brand hero badge: ${result.brands.hero?.badge}`,
+      `brand agent icon only: ${String(result.brands.agent?.label === '' && Boolean(result.brands.agent?.symbol))}`,
