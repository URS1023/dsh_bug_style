+// @vitest-environment jsdom
+import { cleanup, render } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+import { ThemeBrand } from '../src/ThemeBrand.tsx'
+
+afterEach(cleanup)
+
+describe('ThemeBrand', () => {
+  it('renders the full hero identity as decorative theme-controlled seats', () => {
+    const ui = render(<ThemeBrand variant="hero" className="positioned" />)
+    const root = ui.container.querySelector('[data-theme-brand="hero"]')
+
+    expect(root?.getAttribute('aria-hidden')).toBe('true')
+    expect(root?.classList.contains('positioned')).toBe(true)
+    expect(root?.querySelector('[data-theme-brand-mark]')).toBeTruthy()
+    expect(root?.querySelector('[data-theme-brand-label]')).toBeTruthy()
+    expect(root?.querySelector('[data-theme-brand-badge]')).toBeTruthy()
+  })
+
+  it('omits symbol and badge from the workspace text-only variant', () => {
+    const ui = render(<ThemeBrand variant="workspace" />)
+    const root = ui.container.querySelector('[data-theme-brand="workspace"]')
+
+    expect(root?.querySelector('[data-theme-brand-label]')).toBeTruthy()
+    expect(root?.querySelector('[data-theme-brand-mark]')).toBeNull()
+    expect(root?.querySelector('[data-theme-brand-badge]')).toBeNull()
+  })
+
+  it('keeps compact control variants to their declared mark and label seats', () => {
+    for (const [variant, labels] of [
+      ['agent', 0], ['access', 1], ['wordmark', 1], ['rail', 0],
+    ] as const) {
+      const ui = render(<ThemeBrand variant={variant} />)
+      const root = ui.container.querySelector(`[data-theme-brand="${variant}"]`)
+      expect(root?.querySelectorAll('[data-theme-brand-mark]')).toHaveLength(1)
+      expect(root?.querySelectorAll('[data-theme-brand-label]')).toHaveLength(labels)
+      ui.unmount()
+    }
+  })
+})
