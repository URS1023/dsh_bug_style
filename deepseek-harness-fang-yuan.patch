+export function FangYuanSigil() {
+  return (
+    <div className={css.sigil} data-fang-yuan-sigil aria-hidden="true">
+      <span className={css.cicada}>春秋蝉</span>
+      <span className={css.name}>古月方源</span>
+      <span className={css.motto}>求道不悔</span>
+    </div>
+  )
+}
